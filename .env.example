# DumbCellar — variables d'environnement de la fonction serveur /api/ai.
#
# En local : copiez ce fichier en « .env.local » (jamais commité) puis lancez « npm run dev ».
# Sur Vercel : Project Settings → Environment Variables, puis redéployez.
# Ces variables restent côté serveur : aucune n'est incluse dans l'application envoyée au navigateur.

# Clé API Groq (https://console.groq.com/keys). Nécessaire pour que l'assistant IA
# fonctionne sans que chaque utilisateur saisisse sa propre clé dans les réglages.
GROQ_API_KEY=

# Facultatif : code d'accès à partager avec vos proches. S'il est défini, l'application le
# demande dans les réglages de l'assistant IA avant d'utiliser la clé du serveur.
# Recommandé si l'adresse du site est publique (protège votre quota Groq).
APP_ACCESS_CODE=

# Facultatif : modèles Groq utilisés (à changer si Groq retire un modèle).
# Valeurs par défaut :
#   GROQ_MODEL_TEXT=openai/gpt-oss-120b     conseils, accords, fenêtres de dégustation
#   GROQ_MODEL_VISION=qwen/qwen3.8-27b      lecture des étiquettes
#   GROQ_MODEL_WEB=openai/gpt-oss-120b      recherche web intégrée (gpt-oss-120b ou gpt-oss-20b)
#GROQ_MODEL_TEXT=
#GROQ_MODEL_VISION=
#GROQ_MODEL_WEB=
