{
  "name": "bacchus-smartcellar",
  "private": true,
  "version": "1.0.0",
  "description": "Bacchus SmartCellar — gestion d'une cave à vin (armoire réfrigérée) : schéma des clayettes, recherche, réorganisation guidée, sommelier IA.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
